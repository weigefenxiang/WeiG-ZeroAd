#!/system/bin/sh

case "$0" in
  */*) MODDIR=${0%/*}; MODDIR=${MODDIR%/bin} ;;
  # Invoked via PATH lookup there is no directory to derive; use the
  # canonical install location.
  *) MODDIR=/data/adb/modules/weig_rootad ;;
esac
DATA_DIR=/data/adb/weig_rootad
HOSTS_TARGET=/system/etc/hosts
TEST_MODE=0
if [ "${ADSHIELD_TEST_MODE:-0}" = "1" ]; then
  TEST_MODE=1
  DATA_DIR=${ADSHIELD_TEST_DATA_DIR:?ADSHIELD_TEST_DATA_DIR is required}
  HOSTS_TARGET=${ADSHIELD_TEST_HOSTS_TARGET:?ADSHIELD_TEST_HOSTS_TARGET is required}
fi
STATE_DIR=$DATA_DIR/state
USER_DIR=$DATA_DIR/user
ACTIVE_HOSTS=$STATE_DIR/active.hosts
ACTIVE_STATS=$STATE_DIR/active.stats
CN_PROFILE_STATE=$STATE_DIR/cn_profile
CN_LAST_PROFILE_STATE=$STATE_DIR/cn_profile_last
GLOBAL_PROFILE_STATE=$STATE_DIR/global_profile
PROTECTION_STATE=$STATE_DIR/protection
REWARD_UNTIL_STATE=$STATE_DIR/reward_until
RULE_VERSION_STATE=$STATE_DIR/rule_version
PROTECTION_STARTED_STATE=$STATE_DIR/protection_started_at
EVENT_LOG=$STATE_DIR/events.log
ENABLED_PACKS_STATE=$USER_DIR/packs.enabled
LOCK_DIR=$STATE_DIR/.rulectl.lock
RULE_FILES="cn-lean.domains cn-balanced.domains cn-strict.domains global-lean.domains global-balanced.domains global-strict.domains reward-ads.domains reward-tencent.domains reward-wechat.domains reward-short-video.domains reward-other.domains manifest.json packs.json"

fail() {
  echo "error: $1" >&2
  exit 1
}

# Reads the first line of state file $1 into STATE_VALUE without forking a
# subshell or an external cat; STATE_VALUE is empty when the file is missing.
read_state() {
  STATE_VALUE=
  IFS= read -r STATE_VALUE 2>/dev/null < "$1"
}

# Like read_state, but coerces STATE_VALUE to a whole number, falling back to
# $2 (default 0) when the file is missing, empty or corrupt.
read_int_state() {
  read_state "$1"
  case "$STATE_VALUE" in
    ''|*[!0-9]*) STATE_VALUE=${2:-0} ;;
  esac
}

manifest_version() {
  sed -n 's/.*"version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null | head -n 1
}

release_lock() {
  [ "${LOCK_HELD:-0}" = "1" ] || return 0
  # Remove the lock only while this process still owns it; a breaker that
  # reclaimed a stale lock must not delete the new owner's directory.
  read_state "$LOCK_DIR/pid"
  [ "$STATE_VALUE" = "$$" ] && rm -rf "$LOCK_DIR"
  LOCK_HELD=0
}

# Removes whatever temporaries were live when the script stopped, then drops
# the lock. Installed unconditionally before dispatch: __build inherits the
# lock without calling acquire_lock, yet still creates build temporaries.
cleanup_on_exit() {
  [ -z "${BUILD_TMP:-}" ] || rm -rf "$BUILD_TMP"
  [ -z "${STATS_TMP:-}" ] || rm -f "$STATS_TMP"
  [ -z "${PENDING_TMP:-}" ] || rm -rf "$PENDING_TMP"
  release_lock
}

acquire_lock() {
  [ "${ADSHIELD_LOCK_HELD:-0}" != "1" ] || return 0
  waited=0
  ownerless=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    read_state "$LOCK_DIR/pid"
    case "$STATE_VALUE" in
      ''|*[!0-9]*)
        # A fresh lock exists for a moment before its pid file is written.
        # Reclaim only when it stays ownerless across two consecutive checks,
        # otherwise a concurrent starter would lose its live lock.
        ownerless=$((ownerless + 1))
        if [ "$ownerless" -ge 2 ]; then
          rm -rf "$LOCK_DIR"
          ownerless=0
          continue
        fi
        ;;
      *)
        ownerless=0
        if ! kill -0 "$STATE_VALUE" 2>/dev/null; then
          rm -rf "$LOCK_DIR"
          continue
        fi
        ;;
    esac
    [ "$waited" -lt 10 ] || fail "another rule operation is still running"
    sleep 1
    waited=$((waited + 1))
  done
  echo $$ > "$LOCK_DIR/pid"
  LOCK_HELD=1
}

ensure_state() {
  # Runs once per process; several commands call this again on their own path.
  [ "${STATE_READY:-0}" = "1" ] && return 0
  mkdir -p "$STATE_DIR" "$USER_DIR" || fail "cannot create state directory"
  chmod 0700 "$DATA_DIR" "$STATE_DIR" "$USER_DIR" 2>/dev/null
  touch "$USER_DIR/allow.txt" "$USER_DIR/block.txt" "$USER_DIR/disabled.txt" "$ENABLED_PACKS_STATE"
  touch "$EVENT_LOG"
  chmod 0600 "$USER_DIR/allow.txt" "$USER_DIR/block.txt" "$USER_DIR/disabled.txt" "$ENABLED_PACKS_STATE" 2>/dev/null
  chmod 0600 "$EVENT_LOG" 2>/dev/null
  if [ ! -f "$STATE_DIR/profile_schema3" ]; then
    echo lean > "$CN_PROFILE_STATE"
    echo lean > "$CN_LAST_PROFILE_STATE"
    echo off > "$GLOBAL_PROFILE_STATE"
    printf '%s\n' reward.tencent reward.wechat reward.short-video reward.other > "$ENABLED_PACKS_STATE"
    touch "$STATE_DIR/profile_schema3"
  fi
  read_state "$CN_PROFILE_STATE"
  case "$STATE_VALUE" in
    off|lean|balanced|strict) ;;
    *) echo lean > "$CN_PROFILE_STATE" ;;
  esac
  read_state "$CN_LAST_PROFILE_STATE"
  case "$STATE_VALUE" in
    lean|balanced|strict) ;;
    *)
      read_state "$CN_PROFILE_STATE"
      case "$STATE_VALUE" in lean|balanced|strict) echo "$STATE_VALUE" > "$CN_LAST_PROFILE_STATE" ;;
        *) echo lean > "$CN_LAST_PROFILE_STATE" ;; esac
      ;;
  esac
  read_state "$GLOBAL_PROFILE_STATE"
  case "$STATE_VALUE" in
    off|lean|balanced|strict) ;;
    *) echo off > "$GLOBAL_PROFILE_STATE" ;;
  esac
  [ -s "$PROTECTION_STATE" ] || echo 1 > "$PROTECTION_STATE"
  read_state "$PROTECTION_STATE"
  if [ "$STATE_VALUE" = "1" ]; then
    read_state "$PROTECTION_STARTED_STATE"
    case "$STATE_VALUE" in ''|*[!0-9]*) date +%s > "$PROTECTION_STARTED_STATE" ;; esac
  else
    echo 0 > "$PROTECTION_STARTED_STATE"
  fi
  [ -s "$REWARD_UNTIL_STATE" ] || echo 0 > "$REWARD_UNTIL_STATE"
  if [ ! -s "$RULE_VERSION_STATE" ]; then
    manifest=$MODDIR/rules/manifest.json
    [ ! -f "$DATA_DIR/rules/current/manifest.json" ] || manifest=$DATA_DIR/rules/current/manifest.json
    version=$(manifest_version "$manifest")
    [ -n "$version" ] && echo "$version" > "$RULE_VERSION_STATE"
  fi
  [ -s "$RULE_VERSION_STATE" ] || echo 0 > "$RULE_VERSION_STATE"
  STATE_READY=1
}

# Resolves the rule file for profile $1-$2 into PROFILE_PATH without forking;
# fails when the level is unknown or no backing file exists.
resolve_profile() {
  current_rules=$DATA_DIR/rules/current
  region=$1
  level=$2
  case "$region:$level" in
    cn:lean|cn:balanced|cn:strict|global:lean|global:balanced|global:strict) ;;
    *) return 1 ;;
  esac
  name=$region-$level.domains
  if [ -f "$current_rules/$name" ]; then
    PROFILE_PATH=$current_rules/$name
  elif [ -f "$MODDIR/rules/$name" ]; then
    PROFILE_PATH=$MODDIR/rules/$name
  elif [ "$region" = "cn" ]; then
    # Upgrade-compatible fallback for a core package built before schema 3.
    case "$level" in lean|balanced) fallback=balanced.domains ;; strict) fallback=strict.domains ;; esac
    [ -f "$MODDIR/rules/$fallback" ] || return 1
    PROFILE_PATH=$MODDIR/rules/$fallback
  else
    return 1
  fi
}

# Resolves the rule file backing pack id $1 into PACK_PATH without forking;
# fails for unknown pack ids.
resolve_pack() {
  case "$1" in
    reward.tencent) pack_name=reward-tencent.domains ;;
    reward.wechat) pack_name=reward-wechat.domains ;;
    reward.short-video) pack_name=reward-short-video.domains ;;
    reward.other) pack_name=reward-other.domains ;;
    *) return 1 ;;
  esac
  if [ -f "$DATA_DIR/rules/current/$pack_name" ]; then
    PACK_PATH=$DATA_DIR/rules/current/$pack_name
  else
    PACK_PATH=$MODDIR/rules/$pack_name
  fi
}

# Prints the rule files backing every reward pack, one path per line.
all_pack_files() {
  for pack_id in reward.tencent reward.wechat reward.short-video reward.other; do
    resolve_pack "$pack_id" && printf '%s\n' "$PACK_PATH"
  done
}

# Prints the rule files backing the packs the user has enabled, preserving the
# order recorded in the state file.
enabled_pack_files() {
  while IFS= read -r pack_id; do
    [ -n "$pack_id" ] || continue
    resolve_pack "$pack_id" || continue
    printf '%s\n' "$PACK_PATH"
  done < "$ENABLED_PACKS_STATE"
}

count_domains() {
  [ -f "$1" ] || { echo 0; return; }
  awk '!/^[[:space:]]*(#|$)/ { count++ } END { print count + 0 }' "$1"
}

# Single-pass rule composer.
#
# Reads every input file itself with getline instead of relying on a shell
# pipeline, so one awk process replaces the eight cat/sed/awk stages this used
# to take. Only the profile key set is held in memory; the body is streamed to
# body_path as it is produced.
#
# Emission order is the order the previous pipeline produced: profile domains
# (minus reward domains), then the enabled reward packs, then the user block
# list, each deduplicated against everything already emitted and filtered
# through the allow/disabled skip list.
RULE_COMPOSER='
function emit(key) {
  if (protection + 0 != 1) return
  if (key in skip) return
  emit_count++
  print "0.0.0.0 " key > body_path
}

# A user block entry is redundant when the same domain already reached the
# output as a profile rule or as an enabled reward rule.
function already_emitted(key) {
  if (key in profile_seen && !(key in reward)) return 1
  if (reward_blocking + 0 == 1 && key in enabled) return 1
  return 0
}

function load(path, kind,   line, key) {
  if (path == "") return
  while ((getline line < path) > 0) {
    key = line
    # Fast path: validated rule files hold one bare domain per line, so the
    # regex/split work only runs for hand-edited user lists.
    if (key == "" || substr(key, 1, 1) == "#") continue
    if (index(key, " ") || index(key, "\t")) {
      sub(/^[ \t]+/, "", key)
      if (key == "" || substr(key, 1, 1) == "#") continue
      sub(/[ \t].*$/, "", key)
      if (key == "") continue
    }
    if (kind == "reward") {
      reward[key] = 1
    } else if (kind == "enabled") {
      if (key in enabled) continue
      enabled[key] = 1
      enabled_order[++enabled_count] = key
    } else if (kind == "allow") {
      user_allow_count++
      skip[key] = 1
    } else if (kind == "disabled") {
      disabled_count++
      skip[key] = 1
    } else if (kind == "profile") {
      if (key in profile_seen) continue
      profile_seen[key] = 1
      if (key in reward) continue
      compiled_count++
      emit(key)
    } else if (kind == "user") {
      user_block_count++
      if (key in user_seen) continue
      user_seen[key] = 1
      if (already_emitted(key)) continue
      emit(key)
    }
  }
  close(path)
}

function load_list(list, kind,   paths, total, i) {
  total = split(list, paths, "\n")
  for (i = 1; i <= total; i++) load(paths[i], kind)
}

BEGIN {
  load_list(pack_all, "reward")
  load_list(pack_enabled, "enabled")
  load(allow_list, "allow")
  load(disabled_list, "disabled")
  load_list(profile_list, "profile")
  if (reward_blocking + 0 == 1) {
    for (i = 1; i <= enabled_count; i++) emit(enabled_order[i])
  }
  load(block_list, "user")
  close(body_path)
  print "compiled=" (compiled_count + 0) > stats_path
  print "running=" (emit_count + 0) > stats_path
  print "reward_block=" (enabled_count + 0) > stats_path
  print "disabled=" (disabled_count + 0) > stats_path
  print "user_block=" (user_block_count + 0) > stats_path
  print "user_allow=" (user_allow_count + 0) > stats_path
  close(stats_path)
}
'

# compose_rules BODY_PATH STATS_PATH PROFILE_LIST PROTECTION REWARD_BLOCKING
compose_rules() {
  : > "$1" || fail "cannot create rule output"
  awk -v body_path="$1" -v stats_path="$2" -v profile_list="$3" \
      -v protection="$4" -v reward_blocking="$5" \
      -v pack_all="$(all_pack_files)" \
      -v pack_enabled="$(enabled_pack_files)" \
      -v allow_list="$USER_DIR/allow.txt" \
      -v disabled_list="$USER_DIR/disabled.txt" \
      -v block_list="$USER_DIR/block.txt" \
      "$RULE_COMPOSER" || fail "cannot compose rules"
}

count_running() {
  [ -f "$ACTIVE_HOSTS" ] || { echo 0; return; }
  awk '$1 == "0.0.0.0" && NF >= 2 { count++ } END { print count + 0 }' "$ACTIVE_HOSTS"
}

log_event() {
  # Internal messages never carry the field separator; only sanitize when one
  # actually appears instead of forking printf|sed on every event.
  message=$*
  case "$message" in
    *"|"*) message=$(printf '%s' "$message" | sed 's/|/-/g') ;;
  esac
  printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$message" >> "$EVENT_LOG"
  lines=$(wc -l < "$EVENT_LOG" 2>/dev/null)
  case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
  if [ "$lines" -gt 200 ]; then
    tail -n 200 "$EVENT_LOG" > "$EVENT_LOG.tmp" && mv -f "$EVENT_LOG.tmp" "$EVENT_LOG"
  fi
  chmod 0600 "$EVENT_LOG" 2>/dev/null
}

print_events() {
  ensure_state
  read_int_state "$PROTECTION_STARTED_STATE"
  printf 'started_at=%s\n' "$STATE_VALUE"
  tail -n 200 "$EVENT_LOG" 2>/dev/null
}

validate_rule_file() {
  file=$1
  minimum=${2:-1}
  [ -f "$file" ] && [ ! -L "$file" ] || fail "rule file is missing or unsafe"
  size=$(wc -c < "$file" 2>/dev/null)
  case "$size" in ''|*[!0-9]*) fail "cannot read rule file size" ;; esac
  [ "$size" -le 33554432 ] || fail "rule file is too large"
  # One pass validates the format and counts the domains together.
  count=$(awk '
    /^[[:space:]]*(#|$)/ { next }
    $0 !~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ { bad = 1; exit 1 }
    { count++ }
    END { if (bad) exit 1; print count + 0 }
  ' "$file") || fail "rule file contains an invalid domain"
  case "$count" in ''|*[!0-9]*) fail "rule file contains an invalid domain" ;; esac
  [ "$count" -ge "$minimum" ] && [ "$count" -le 500000 ] || fail "rule count is outside the safe range"
}

# Loads one rule file into memory and streams the others past it, so each check
# batch holds a single domain set no matter how many relations it verifies.
# Every relation is "mode|label|path": subset requires the streamed file to be
# contained in the loaded one, disjoint requires no shared domain.
RULE_RELATION_CHECKER='
function key_of(line,   key) {
  key = line
  if (key == "" || substr(key, 1, 1) == "#") return ""
  if (index(key, " ") || index(key, "\t")) {
    sub(/^[ \t]+/, "", key)
    if (key == "" || substr(key, 1, 1) == "#") return ""
    sub(/[ \t].*$/, "", key)
  }
  return key
}

# getline returns -1 for an unreadable file, which a plain while-loop would
# treat like EOF and pass the check vacuously; every read error must fail.
function load(path, arr,   line, key, got) {
  got = (getline line < path)
  if (got < 0) { print "cannot read rule file"; exit 1 }
  while (got > 0) {
    key = key_of(line)
    if (key != "") arr[key] = 1
    got = (getline line < path)
  }
  close(path)
}

BEGIN {
  load(parent, base)
  total = split(relations, items, "\n")
  for (i = 1; i <= total; i++) {
    if (items[i] == "") continue
    split(items[i], field, "|")
    mode = field[1]
    label = field[2]
    path = field[3]
    got = (getline line < path)
    if (got < 0) { print "cannot read rule file"; exit 1 }
    while (got > 0) {
      key = key_of(line)
      if (key != "") {
        present = (key in base)
        if (mode == "subset" ? !present : present) {
          print label
          close(path)
          exit 1
        }
      }
      got = (getline line < path)
    }
    close(path)
  }
}
'

# check_relations PARENT_FILE RELATIONS
check_relations() {
  violation=$(awk -v parent="$1" -v relations="$2" "$RULE_RELATION_CHECKER") && return 0
  fail "${violation:-rule relation check failed}"
}

install_rule_directory() {
  source_dir=$1
  case "$source_dir" in
    /data/local/tmp/weig_zeroad-rules-*) ;;
    *) fail "unsafe staging directory" ;;
  esac
  [ -d "$source_dir" ] && [ ! -L "$source_dir" ] || fail "staging directory is missing"
  for name in cn-lean cn-balanced cn-strict global-lean global-balanced global-strict; do
    validate_rule_file "$source_dir/$name.domains"
  done
  for name in reward-ads reward-tencent reward-wechat reward-short-video reward-other; do
    validate_rule_file "$source_dir/$name.domains" 0
  done
  for name in manifest.json packs.json; do
    [ -f "$source_dir/$name" ] && [ ! -L "$source_dir/$name" ] || fail "$name is missing"
  done
  version=$(manifest_version "$source_dir/manifest.json")
  case "$version" in ''|*[!0-9]*) fail "invalid rule version" ;; esac

  # Four batches instead of eleven two-file passes. Checking reward overlap
  # against the strict profiles alone is sufficient: the subset checks run
  # first, so lean and balanced cannot contain a domain strict does not.
  check_relations "$source_dir/cn-balanced.domains" \
    "subset|cn lean is not a subset of balanced|$source_dir/cn-lean.domains"
  check_relations "$source_dir/cn-strict.domains" \
    "subset|cn balanced is not a subset of strict|$source_dir/cn-balanced.domains
disjoint|domestic and global rules overlap|$source_dir/global-strict.domains
disjoint|reward rules overlap the domestic profiles|$source_dir/reward-ads.domains"
  check_relations "$source_dir/global-balanced.domains" \
    "subset|global lean is not a subset of balanced|$source_dir/global-lean.domains"
  check_relations "$source_dir/global-strict.domains" \
    "subset|global balanced is not a subset of strict|$source_dir/global-balanced.domains
disjoint|reward rules overlap the global profiles|$source_dir/reward-ads.domains"

  rules_root=$DATA_DIR/rules
  PENDING_TMP=$rules_root/.pending.$$
  mkdir -p "$PENDING_TMP" || fail "cannot create rule staging area"
  for name in $RULE_FILES; do
    cp -f "$source_dir/$name" "$PENDING_TMP/$name" || fail "cannot stage $name"
  done
  chmod 0600 "$PENDING_TMP"/* 2>/dev/null
  if ! activate_rules "$PENDING_TMP" "$version" "new rules" "previous rules"; then
    PENDING_TMP=
    rm -rf "$source_dir"
    fail "new rules failed; previous rules were restored: $ACTIVATE_ERROR"
  fi
  PENDING_TMP=
  rm -rf "$source_dir"
  log_event "rules-installed version=$version"
  status_json
}

# Swaps NEW_DIR into rules/current, rebuilds, and restores the displaced
# directory if the rebuild fails. Shared by installs and rollbacks, which differ
# only in where the incoming directory comes from and how failures are worded.
#
# activate_rules NEW_DIR NEW_VERSION LABEL RESTORED_LABEL
# Returns 1 with $ACTIVATE_ERROR set when the new rules failed but the previous
# ones were put back; fails outright when the restore itself did not work.
activate_rules() {
  new_dir=$1
  new_version=$2
  label=$3
  restored=$4
  rules_root=$DATA_DIR/rules
  displaced=$rules_root/.displaced.$$
  read_int_state "$RULE_VERSION_STATE"
  old_version=$STATE_VALUE

  rm -rf "$displaced"
  [ ! -d "$rules_root/current" ] || mv "$rules_root/current" "$displaced" ||
    fail "cannot preserve current rules"
  if ! mv "$new_dir" "$rules_root/current"; then
    [ ! -d "$displaced" ] || mv "$displaced" "$rules_root/current"
    fail "cannot activate rules"
  fi
  echo "$new_version" > "$RULE_VERSION_STATE"
  if build_output=$(ADSHIELD_LOCK_HELD=1 "$MODDIR/bin/rulectl" __build 2>&1); then
    rm -rf "$rules_root/previous"
    [ ! -d "$displaced" ] || mv "$displaced" "$rules_root/previous"
    return 0
  fi
  rm -rf "$rules_root/current"
  [ ! -d "$displaced" ] || mv "$displaced" "$rules_root/current"
  echo "$old_version" > "$RULE_VERSION_STATE"
  restore_output=$(ADSHIELD_LOCK_HELD=1 "$MODDIR/bin/rulectl" __build 2>&1) ||
    fail "$label failed and $restored could not be restored: $restore_output"
  ACTIVATE_ERROR=$build_output
  return 1
}

rollback_rules() {
  rules_root=$DATA_DIR/rules
  [ -d "$rules_root/previous" ] || fail "no previous rule version is available"
  version=$(manifest_version "$rules_root/previous/manifest.json")
  case "$version" in ''|*[!0-9]*) version=0 ;; esac
  if ! activate_rules "$rules_root/previous" "$version" "rollback" "current rules"; then
    fail "rollback failed; current rules were restored: $ACTIVATE_ERROR"
  fi
  log_event "rules-rollback version=$version"
  status_json
}

same_file() {
  [ -f "$ACTIVE_HOSTS" ] && [ -f "$HOSTS_TARGET" ] || return 1
  if [ "$TEST_MODE" = "1" ]; then
    cmp -s "$ACTIVE_HOSTS" "$HOSTS_TARGET"
    return
  fi
  source_stat=$(stat -c '%d:%i' "$ACTIVE_HOSTS" 2>/dev/null)
  target_stat=$(stat -c '%d:%i' "$HOSTS_TARGET" 2>/dev/null)
  [ -n "$source_stat" ] && [ "$source_stat" = "$target_stat" ]
}

ensure_mounted() {
  same_file && return 0
  if [ "$TEST_MODE" = "1" ]; then
    cp -f "$ACTIVE_HOSTS" "$HOSTS_TARGET" || fail "cannot publish test hosts file"
    return
  fi
  mount --bind "$ACTIVE_HOSTS" "$HOSTS_TARGET" >/dev/null 2>&1 || \
    mount -o bind "$ACTIVE_HOSTS" "$HOSTS_TARGET" >/dev/null 2>&1 || \
    fail "cannot bind active hosts file"
}

publish_active() {
  new_file=$1
  if [ -f "$ACTIVE_HOSTS" ]; then
    # In-place copy: the bind mount pins the inode, so a rename cannot be used.
    cp -f "$new_file" "$ACTIVE_HOSTS" || fail "cannot update active hosts"
  else
    mv -f "$new_file" "$ACTIVE_HOSTS" || fail "cannot create active hosts"
  fi
  chown 0:0 "$ACTIVE_HOSTS" 2>/dev/null
  chmod 0644 "$ACTIVE_HOSTS" 2>/dev/null
  chcon u:object_r:system_file:s0 "$ACTIVE_HOSTS" 2>/dev/null
  ensure_mounted
}

build_active() {
  ensure_state
  read_state "$CN_PROFILE_STATE"
  cn_profile=$STATE_VALUE
  read_state "$GLOBAL_PROFILE_STATE"
  global_profile=$STATE_VALUE
  cn_file=
  if [ "$cn_profile" != "off" ]; then
    resolve_profile cn "$cn_profile" || fail "invalid domestic profile state"
    cn_file=$PROFILE_PATH
    [ -f "$cn_file" ] || fail "domestic profile rules are missing: $cn_profile"
  fi
  global_file=
  if [ "$global_profile" != "off" ]; then
    resolve_profile global "$global_profile" || fail "global profile is not installed: $global_profile"
    global_file=$PROFILE_PATH
    [ -f "$global_file" ] || fail "global profile rules are missing: $global_profile"
  fi

  BUILD_TMP=$STATE_DIR/.build.$$
  mkdir -p "$BUILD_TMP" || fail "cannot create temporary directory"
  body_file=$BUILD_TMP/body
  stats_file=$BUILD_TMP/stats
  output_file=$BUILD_TMP/active.hosts

  protection=0
  read_state "$PROTECTION_STATE"
  [ "$STATE_VALUE" != "1" ] || protection=1
  read_int_state "$REWARD_UNTIL_STATE"
  reward_until=$STATE_VALUE
  reward_blocking=0
  [ "$reward_until" -gt "$(date +%s)" ] || reward_blocking=1

  compose_rules "$body_file" "$stats_file" "$cn_file
$global_file" "$protection" "$reward_blocking"

  running=
  while IFS='=' read -r key value; do
    [ "$key" = "running" ] && running=$value
  done 2>/dev/null < "$stats_file"
  read_state "$RULE_VERSION_STATE"
  version=$STATE_VALUE
  {
    echo "# WeiG ZeroAd active hosts. Managed by rulectl."
    echo "# cn_profile=$cn_profile"
    echo "# global_profile=$global_profile"
    echo "# rule_version=$version"
    echo "# rule_count=$running"
    echo "127.0.0.1 localhost"
    echo "::1 localhost ip6-localhost ip6-loopback"
    cat "$body_file"
  } > "$output_file" || fail "cannot build active hosts"

  publish_active "$output_file"
  mv -f "$stats_file" "$ACTIVE_STATS" || fail "cannot record rule statistics"
  chmod 0600 "$ACTIVE_STATS" 2>/dev/null
  rm -rf "$BUILD_TMP"
  BUILD_TMP=
  log_event "applied cn=$cn_profile global=$global_profile running=$running"
}

list_add() {
  list=$1
  domain=$2
  tmp=$list.$$
  # Single pass: drop comments and blanks, keep the first occurrence of every
  # line, and append the new domain only when it was not already present.
  awk -v domain="$domain" '
    /^[[:space:]]*(#|$)/ { next }
    seen[$0]++ { next }
    { print }
    END { if (domain != "" && !(domain in seen)) print domain }
  ' "$list" 2>/dev/null > "$tmp" || { rm -f "$tmp"; fail "cannot update rule list"; }
  mv -f "$tmp" "$list" || fail "cannot save rule list"
  chmod 0600 "$list" 2>/dev/null
}

list_remove() {
  list=$1
  domain=$2
  [ -f "$list" ] || return 0
  tmp=$list.$$
  # The write must succeed before the original is replaced; moving a truncated
  # temp file over the list would silently destroy the user's entries.
  awk -v domain="$domain" '$0 != domain { print }' "$list" 2>/dev/null > "$tmp" ||
    { rm -f "$tmp"; fail "cannot update rule list"; }
  mv -f "$tmp" "$list" || fail "cannot save rule list"
  chmod 0600 "$list" 2>/dev/null
}

domain_argument() {
  [ -n "$1" ] || fail "domain is required"
  # One awk call lower-cases, strips a trailing dot and validates, replacing
  # the five processes the tr/sed/grep pipeline used to spawn.
  domain=$(printf '%s\n' "$1" | awk '
    NR == 1 {
      d = tolower($0)
      sub(/\.$/, "", d)
      if (d !~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/) exit 1
      print d
      ok = 1
      exit
    }
    END { if (!ok) exit 1 }
  ') || fail "invalid exact domain: $1"
  printf '%s\n' "$domain"
}

set_profile() {
  region=$1
  new_profile=$2
  case "$region" in
    cn)
      if [ "$new_profile" = "off" ]; then
        read_state "$CN_PROFILE_STATE"
        case "$STATE_VALUE" in lean|balanced|strict) echo "$STATE_VALUE" > "$CN_LAST_PROFILE_STATE" ;; esac
        echo off > "$CN_PROFILE_STATE"
      else
        if [ "$new_profile" = "on" ]; then
          read_state "$CN_LAST_PROFILE_STATE"
          new_profile=$STATE_VALUE
        fi
        case "$new_profile" in lean|balanced|strict) ;;
          *) new_profile=lean ;; esac
        resolve_profile cn "$new_profile" || fail "unknown domestic profile: $new_profile"
        echo "$new_profile" > "$CN_PROFILE_STATE"
        echo "$new_profile" > "$CN_LAST_PROFILE_STATE"
      fi
      ;;
    global)
      if [ "$new_profile" = "off" ]; then
        echo off > "$GLOBAL_PROFILE_STATE"
      else
        resolve_profile global "$new_profile" || fail "global profile is not installed: $new_profile"
        echo "$new_profile" > "$GLOBAL_PROFILE_STATE"
      fi
      ;;
    *) fail "unknown profile region: $region" ;;
  esac
  build_active
}

set_pack() {
  action=$1
  pack_id=$2
  resolve_pack "$pack_id" || fail "unknown rule pack: $pack_id"
  [ -f "$PACK_PATH" ] || fail "rule pack is not installed: $pack_id"
  if [ "$action" = "enable" ]; then
    list_add "$ENABLED_PACKS_STATE" "$pack_id"
  else
    list_remove "$ENABLED_PACKS_STATE" "$pack_id"
  fi
  build_active
}

start_reward_timer() {
  minutes=$1
  case "$minutes" in
    ''|*[!0-9]*) fail "reward duration must be an integer" ;;
  esac
  [ "$minutes" -ge 1 ] && [ "$minutes" -le 1440 ] || fail "reward duration must be 1-1440 minutes"
  ensure_state
  [ "$(count_domains "$ENABLED_PACKS_STATE")" -gt 0 ] || fail "enable a reward-ad pack first"
  expires=$(( $(date +%s) + minutes * 60 ))
  echo "$expires" > "$REWARD_UNTIL_STATE"
  build_active
  log_event "reward-allow minutes=$minutes"
  if [ "$TEST_MODE" != "1" ]; then
    (
      sleep $(( minutes * 60 ))
      "$MODDIR/bin/rulectl" reward-expire "$expires" >/dev/null 2>&1
    ) &
  fi
  echo "reward ads allowed until $expires"
}

expire_reward() {
  expected=$1
  ensure_state
  read_int_state "$REWARD_UNTIL_STATE"
  actual=$STATE_VALUE
  [ "$expected" = "$actual" ] || return 0
  [ "$actual" -gt 0 ] || return 0
  echo 0 > "$REWARD_UNTIL_STATE"
  build_active
  log_event "reward-blocking-restored"
}

resume_reward_timer() {
  read_int_state "$REWARD_UNTIL_STATE"
  expires=$STATE_VALUE
  now=$(date +%s)
  if [ "$expires" -le "$now" ]; then
    expire_reward "$expires"
  else
    remaining=$(( expires - now ))
    (
      sleep "$remaining"
      "$MODDIR/bin/rulectl" reward-expire "$expires" >/dev/null 2>&1
    ) &
  fi
}

status_json() {
  ensure_state
  read_state "$CN_PROFILE_STATE"
  cn_profile=$STATE_VALUE
  read_state "$GLOBAL_PROFILE_STATE"
  global_profile=$STATE_VALUE
  cn_file=
  [ "$cn_profile" = "off" ] || { resolve_profile cn "$cn_profile" && cn_file=$PROFILE_PATH; }
  global_file=
  [ "$global_profile" = "off" ] || { resolve_profile global "$global_profile" && global_file=$PROFILE_PATH; }
  compiled= running= reward_block= disabled= user_block= user_allow=
  while IFS='=' read -r key value; do
    case "$key" in
      compiled) compiled=$value ;;
      running) running=$value ;;
      reward_block) reward_block=$value ;;
      disabled) disabled=$value ;;
      user_block) user_block=$value ;;
      user_allow) user_allow=$value ;;
    esac
  done 2>/dev/null < "$ACTIVE_STATS"
  # The stats cache is written in one atomic move, so a bad value in any field
  # means the whole file is unusable (or predates these fields). Recompute all
  # of them in one composer pass; it runs with protection off so it never
  # touches the active mount.
  stale=0
  for value in "$compiled" "$reward_block" "$disabled" "$user_block" "$user_allow"; do
    case "$value" in ''|*[!0-9]*) stale=1 ;; esac
  done
  if [ "$stale" = "1" ]; then
    STATS_TMP=$STATE_DIR/.stats.$$
    compose_rules /dev/null "$STATS_TMP" "$cn_file
$global_file" 0 1
    while IFS='=' read -r key value; do
      case "$key" in
        compiled) compiled=$value ;;
        reward_block) reward_block=$value ;;
        disabled) disabled=$value ;;
        user_block) user_block=$value ;;
        user_allow) user_allow=$value ;;
      esac
    done 2>/dev/null < "$STATS_TMP"
    rm -f "$STATS_TMP"
    STATS_TMP=
  fi
  case "$running" in ''|*[!0-9]*) running=$(count_running) ;; esac
  read_state "$RULE_VERSION_STATE"
  version=$STATE_VALUE
  read_int_state "$REWARD_UNTIL_STATE"
  reward_until=$STATE_VALUE
  now=$(date +%s)
  [ "$reward_until" -gt "$now" ] && reward_active=true || reward_active=false
  enabled_packs=
  while IFS= read -r pack_id; do
    [ -n "$pack_id" ] || continue
    resolve_pack "$pack_id" || continue
    [ -z "$enabled_packs" ] && enabled_packs=$pack_id || enabled_packs=$enabled_packs,$pack_id
  done < "$ENABLED_PACKS_STATE"
  read_state "$PROTECTION_STATE"
  [ "$STATE_VALUE" = "1" ] && protection=true || protection=false
  if [ -d /data/adb/modules_update/weig_rootad ] || [ -f /data/adb/modules/weig_rootad/update ]; then
    pending_reboot=true
  else
    pending_reboot=false
  fi
  same_file && healthy=true || healthy=false
  [ -f "$DATA_DIR/rules/current/manifest.json" ] && rules_downloaded=true || rules_downloaded=false
  root_impl=unknown
  command -v magisk >/dev/null 2>&1 && root_impl=magisk
  command -v ksud >/dev/null 2>&1 && root_impl=kernelsu
  command -v apd >/dev/null 2>&1 && root_impl=apatch
  core_version=
  core_version_code=
  while IFS='=' read -r key value; do
    case "$key" in
      version) [ -n "$core_version" ] || core_version=$value ;;
      versionCode) [ -n "$core_version_code" ] || core_version_code=$value ;;
    esac
  done 2>/dev/null < "$MODDIR/module.prop"
  core_version=$(printf '%s' "$core_version" | tr -cd 'A-Za-z0-9._+-')
  case "$core_version_code" in ''|*[!0-9]*) core_version_code=0 ;; esac
  printf '{"schema":3,"pending_reboot":%s,"protection_enabled":%s,"healthy":%s,"root_impl":"%s","core_version":"%s","core_version_code":%s,"cn_profile":"%s","global_profile":"%s","rule_version":%s,"rules_downloaded":%s,"compiled_rules":%s,"running_rules":%s,"disabled_rules":%s,"user_block_rules":%s,"user_allow_rules":%s,"reward_block_rules":%s,"reward_temporarily_allowed":%s,"reward_expires_at":%s,"enabled_packs":"%s"}\n' \
    "$pending_reboot" "$protection" "$healthy" "$root_impl" "$core_version" "$core_version_code" "$cn_profile" "$global_profile" "$version" "$rules_downloaded" "$compiled" "$running" "$disabled" "$user_block" "$user_allow" "$reward_block" "$reward_active" "$reward_until" "$enabled_packs"
}

command=${1:-status}
trap cleanup_on_exit EXIT HUP INT TERM
ensure_state
acquire_lock

case "$command" in
  status)
    status_json
    ;;
  boot)
    build_active
    resume_reward_timer
    ;;
  rebuild)
    build_active
    status_json
    ;;
  __build)
    [ "${ADSHIELD_LOCK_HELD:-0}" = "1" ] || fail "internal command"
    build_active
    ;;
  cn-profile)
    [ -n "${2:-}" ] || fail "domestic profile name is required"
    set_profile cn "$2"
    status_json
    ;;
  global-profile)
    [ -n "${2:-}" ] || fail "global profile name is required"
    set_profile global "$2"
    status_json
    ;;
  profile)
    # Backward-compatible command for older manager versions.
    [ -n "${2:-}" ] || fail "profile name is required"
    case "$2" in strict|balanced) set_profile cn "$2" ;; *) fail "unknown legacy profile: $2" ;; esac
    status_json
    ;;
  reward)
    start_reward_timer "${2:-10}"
    status_json
    ;;
  reward-expire)
    expire_reward "${2:-0}"
    ;;
  reward-stop)
    # Sanitized like every other reader: a corrupt state file must not make
    # the stop silently miss the string comparison inside expire_reward.
    read_int_state "$REWARD_UNTIL_STATE"
    expire_reward "$STATE_VALUE"
    status_json
    ;;
  pack-enable)
    [ -n "${2:-}" ] || fail "pack id is required"
    set_pack enable "$2"
    status_json
    ;;
  pack-disable)
    [ -n "${2:-}" ] || fail "pack id is required"
    set_pack disable "$2"
    status_json
    ;;
  protection-on)
    echo 1 > "$PROTECTION_STATE"
    date +%s > "$PROTECTION_STARTED_STATE"
    build_active
    log_event "protection-enabled"
    status_json
    ;;
  protection-off)
    echo 0 > "$PROTECTION_STATE"
    echo 0 > "$PROTECTION_STARTED_STATE"
    build_active
    log_event "protection-disabled"
    status_json
    ;;
  domain-disable)
    domain=$(domain_argument "${2:-}") || exit 1
    list_add "$USER_DIR/disabled.txt" "$domain"
    build_active
    status_json
    ;;
  domain-enable)
    domain=$(domain_argument "${2:-}") || exit 1
    list_remove "$USER_DIR/disabled.txt" "$domain"
    build_active
    status_json
    ;;
  allow-add)
    domain=$(domain_argument "${2:-}") || exit 1
    list_remove "$USER_DIR/block.txt" "$domain"
    list_add "$USER_DIR/allow.txt" "$domain"
    build_active
    status_json
    ;;
  allow-remove)
    domain=$(domain_argument "${2:-}") || exit 1
    list_remove "$USER_DIR/allow.txt" "$domain"
    build_active
    status_json
    ;;
  block-add)
    domain=$(domain_argument "${2:-}") || exit 1
    list_remove "$USER_DIR/allow.txt" "$domain"
    list_add "$USER_DIR/block.txt" "$domain"
    build_active
    status_json
    ;;
  block-remove)
    domain=$(domain_argument "${2:-}") || exit 1
    list_remove "$USER_DIR/block.txt" "$domain"
    build_active
    status_json
    ;;
  rules-install-dir)
    [ -n "${2:-}" ] || fail "staging directory is required"
    install_rule_directory "$2"
    ;;
  rules-rollback)
    rollback_rules
    ;;
  list-disabled)
    cat "$USER_DIR/disabled.txt"
    ;;
  list-allow)
    cat "$USER_DIR/allow.txt"
    ;;
  list-block)
    cat "$USER_DIR/block.txt"
    ;;
  events)
    print_events
    ;;
  cleanup-mount)
    if [ "$TEST_MODE" = "1" ]; then
      rm -f "$HOSTS_TARGET"
    elif same_file; then
      umount "$HOSTS_TARGET" >/dev/null 2>&1 || fail "cannot unmount active hosts"
    fi
    ;;
  *)
    fail "unknown command: $command"
    ;;
esac
