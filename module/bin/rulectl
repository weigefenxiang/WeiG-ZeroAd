#!/system/bin/sh

MODDIR=${0%/*}
MODDIR=${MODDIR%/bin}
DATA_DIR=/data/adb/weig_rootad
HOSTS_TARGET=/system/etc/hosts
TEST_MODE=0
if [ "${ADSHIELD_TEST_MODE:-0}" = "1" ]; then
  TEST_MODE=1
  DATA_DIR=${ADSHIELD_TEST_DATA_DIR:?ADSHIELD_TEST_DATA_DIR is required}
  HOSTS_TARGET=${ADSHIELD_TEST_HOSTS_TARGET:?ADSHIELD_TEST_HOSTS_TARGET is required}
fi
STATE_DIR=$DATA_DIR/state
USER_DIR=$DATA_DIR/user
ACTIVE_HOSTS=$STATE_DIR/active.hosts
ACTIVE_STATS=$STATE_DIR/active.stats
CN_PROFILE_STATE=$STATE_DIR/cn_profile
CN_LAST_PROFILE_STATE=$STATE_DIR/cn_profile_last
GLOBAL_PROFILE_STATE=$STATE_DIR/global_profile
PROTECTION_STATE=$STATE_DIR/protection
REWARD_UNTIL_STATE=$STATE_DIR/reward_until
RULE_VERSION_STATE=$STATE_DIR/rule_version
PROTECTION_STARTED_STATE=$STATE_DIR/protection_started_at
EVENT_LOG=$STATE_DIR/events.log
ENABLED_PACKS_STATE=$USER_DIR/packs.enabled
LOCK_DIR=$STATE_DIR/.rulectl.lock
RULE_FILES="cn-lean.domains cn-balanced.domains cn-strict.domains global-lean.domains global-balanced.domains global-strict.domains reward-ads.domains reward-tencent.domains reward-wechat.domains reward-short-video.domains reward-other.domains manifest.json packs.json"

fail() {
  echo "error: $1" >&2
  exit 1
}

release_lock() {
  [ "${LOCK_HELD:-0}" = "1" ] || return 0
  rm -rf "$LOCK_DIR"
  LOCK_HELD=0
}

acquire_lock() {
  [ "${ADSHIELD_LOCK_HELD:-0}" != "1" ] || return 0
  waited=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    owner=$(cat "$LOCK_DIR/pid" 2>/dev/null)
    case "$owner" in
      ''|*[!0-9]*) rm -rf "$LOCK_DIR"; continue ;;
    esac
    if ! kill -0 "$owner" 2>/dev/null; then
      rm -rf "$LOCK_DIR"
      continue
    fi
    [ "$waited" -lt 10 ] || fail "another rule operation is still running"
    sleep 1
    waited=$((waited + 1))
  done
  echo $$ > "$LOCK_DIR/pid"
  LOCK_HELD=1
  trap release_lock EXIT HUP INT TERM
}

ensure_state() {
  mkdir -p "$STATE_DIR" "$USER_DIR" || fail "cannot create state directory"
  chmod 0700 "$DATA_DIR" "$STATE_DIR" "$USER_DIR" 2>/dev/null
  touch "$USER_DIR/allow.txt" "$USER_DIR/block.txt" "$USER_DIR/disabled.txt" "$ENABLED_PACKS_STATE"
  touch "$EVENT_LOG"
  chmod 0600 "$USER_DIR/allow.txt" "$USER_DIR/block.txt" "$USER_DIR/disabled.txt" "$ENABLED_PACKS_STATE" 2>/dev/null
  chmod 0600 "$EVENT_LOG" 2>/dev/null
  if [ ! -f "$STATE_DIR/profile_schema3" ]; then
    echo lean > "$CN_PROFILE_STATE"
    echo lean > "$CN_LAST_PROFILE_STATE"
    echo off > "$GLOBAL_PROFILE_STATE"
    printf '%s\n' reward.tencent reward.wechat reward.short-video reward.other > "$ENABLED_PACKS_STATE"
    touch "$STATE_DIR/profile_schema3"
  fi
  case "$(cat "$CN_PROFILE_STATE" 2>/dev/null)" in
    off|lean|balanced|strict) ;;
    *) echo lean > "$CN_PROFILE_STATE" ;;
  esac
  case "$(cat "$CN_LAST_PROFILE_STATE" 2>/dev/null)" in
    lean|balanced|strict) ;;
    *)
      current_cn=$(cat "$CN_PROFILE_STATE" 2>/dev/null)
      case "$current_cn" in lean|balanced|strict) echo "$current_cn" > "$CN_LAST_PROFILE_STATE" ;;
        *) echo lean > "$CN_LAST_PROFILE_STATE" ;; esac
      ;;
  esac
  case "$(cat "$GLOBAL_PROFILE_STATE" 2>/dev/null)" in
    off|lean|balanced|strict) ;;
    *) echo off > "$GLOBAL_PROFILE_STATE" ;;
  esac
  [ -s "$PROTECTION_STATE" ] || echo 1 > "$PROTECTION_STATE"
  if [ "$(cat "$PROTECTION_STATE" 2>/dev/null)" = "1" ]; then
    started=$(cat "$PROTECTION_STARTED_STATE" 2>/dev/null)
    case "$started" in ''|*[!0-9]*) date +%s > "$PROTECTION_STARTED_STATE" ;; esac
  else
    echo 0 > "$PROTECTION_STARTED_STATE"
  fi
  [ -s "$REWARD_UNTIL_STATE" ] || echo 0 > "$REWARD_UNTIL_STATE"
  if [ ! -s "$RULE_VERSION_STATE" ]; then
    manifest=$MODDIR/rules/manifest.json
    [ ! -f "$DATA_DIR/rules/current/manifest.json" ] || manifest=$DATA_DIR/rules/current/manifest.json
    version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$manifest" 2>/dev/null | head -n 1)
    [ -n "$version" ] && echo "$version" > "$RULE_VERSION_STATE"
  fi
  [ -s "$RULE_VERSION_STATE" ] || echo 0 > "$RULE_VERSION_STATE"
}

normalize_domain() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[.]$//'
}

valid_domain() {
  printf '%s\n' "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'
}

profile_path() {
  current_rules=$DATA_DIR/rules/current
  region=$1
  level=$2
  case "$region:$level" in
    cn:lean|cn:balanced|cn:strict|global:lean|global:balanced|global:strict) ;;
    *) return 1 ;;
  esac
  name=$region-$level.domains
  if [ -f "$current_rules/$name" ]; then
    printf '%s/%s\n' "$current_rules" "$name"
  elif [ -f "$MODDIR/rules/$name" ]; then
    printf '%s/rules/%s\n' "$MODDIR" "$name"
  elif [ "$region" = "cn" ]; then
    # Upgrade-compatible fallback for a core package built before schema 3.
    case "$level" in lean|balanced) fallback=balanced.domains ;; strict) fallback=strict.domains ;; esac
    [ -f "$MODDIR/rules/$fallback" ] || return 1
    printf '%s/rules/%s\n' "$MODDIR" "$fallback"
  else
    return 1
  fi
}

pack_file_name() {
  case "$1" in
    reward.tencent) echo reward-tencent.domains ;;
    reward.wechat) echo reward-wechat.domains ;;
    reward.short-video) echo reward-short-video.domains ;;
    reward.other) echo reward-other.domains ;;
    *) return 1 ;;
  esac
}

pack_path() {
  name=$(pack_file_name "$1") || return 1
  current_rules=$DATA_DIR/rules/current
  if [ -f "$current_rules/$name" ]; then
    printf '%s/%s\n' "$current_rules" "$name"
  else
    printf '%s/rules/%s\n' "$MODDIR" "$name"
  fi
}

write_reward_union() {
  output=$1
  raw=$output.raw
  : > "$raw"
  for pack_id in reward.tencent reward.wechat reward.short-video reward.other; do
    source=$(pack_path "$pack_id") || continue
    cat "$source" >> "$raw"
  done
  sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' "$raw" | awk '!seen[$0]++' > "$output"
  rm -f "$raw"
}

write_enabled_reward_union() {
  output=$1
  raw=$output.raw
  : > "$raw"
  while IFS= read -r pack_id; do
    [ -n "$pack_id" ] || continue
    source=$(pack_path "$pack_id") || continue
    cat "$source" >> "$raw"
  done < "$ENABLED_PACKS_STATE"
  sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' "$raw" | awk '!seen[$0]++' > "$output"
  rm -f "$raw"
}

count_domains() {
  [ -f "$1" ] || { echo 0; return; }
  awk '!/^[[:space:]]*(#|$)/ { count++ } END { print count + 0 }' "$1"
}

count_running() {
  [ -f "$ACTIVE_HOSTS" ] || { echo 0; return; }
  awk '$1 == "0.0.0.0" && NF >= 2 { count++ } END { print count + 0 }' "$ACTIVE_HOSTS"
}

log_event() {
  message=$(printf '%s' "$*" | sed 's/|/-/g')
  printf '%s | %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$message" >> "$EVENT_LOG"
  lines=$(wc -l < "$EVENT_LOG" 2>/dev/null)
  case "$lines" in ''|*[!0-9]*) lines=0 ;; esac
  if [ "$lines" -gt 200 ]; then
    tail -n 200 "$EVENT_LOG" > "$EVENT_LOG.tmp" && mv -f "$EVENT_LOG.tmp" "$EVENT_LOG"
  fi
  chmod 0600 "$EVENT_LOG" 2>/dev/null
}

print_events() {
  ensure_state
  started=$(cat "$PROTECTION_STARTED_STATE" 2>/dev/null)
  case "$started" in ''|*[!0-9]*) started=0 ;; esac
  printf 'started_at=%s\n' "$started"
  tail -n 200 "$EVENT_LOG" 2>/dev/null
}

validate_rule_file() {
  file=$1
  minimum=${2:-1}
  [ -f "$file" ] && [ ! -L "$file" ] || fail "rule file is missing or unsafe"
  size=$(wc -c < "$file" 2>/dev/null)
  [ "$size" -le 33554432 ] || fail "rule file is too large"
  invalid=$(awk '
    /^[[:space:]]*(#|$)/ { next }
    $0 !~ /^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$/ { print; exit }
  ' "$file")
  [ -z "$invalid" ] || fail "rule file contains an invalid domain"
  count=$(count_domains "$file")
  [ "$count" -ge "$minimum" ] && [ "$count" -le 500000 ] || fail "rule count is outside the safe range"
}

install_rule_directory() {
  source_dir=$1
  case "$source_dir" in
    /data/local/tmp/weig_zeroad-rules-*) ;;
    *) fail "unsafe staging directory" ;;
  esac
  [ -d "$source_dir" ] && [ ! -L "$source_dir" ] || fail "staging directory is missing"
  for name in cn-lean cn-balanced cn-strict global-lean global-balanced global-strict; do
    validate_rule_file "$source_dir/$name.domains"
  done
  for name in reward-ads reward-tencent reward-wechat reward-short-video reward-other; do
    validate_rule_file "$source_dir/$name.domains" 0
  done
  for name in manifest.json packs.json; do
    [ -f "$source_dir/$name" ] && [ ! -L "$source_dir/$name" ] || fail "$name is missing"
  done
  version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$source_dir/manifest.json" | head -n 1)
  case "$version" in ''|*[!0-9]*) fail "invalid rule version" ;; esac

  missing=$(awk 'NR == FNR { parent[$1] = 1; next } !/^[[:space:]]*(#|$)/ && !($1 in parent) { count++ } END { print count + 0 }' \
    "$source_dir/cn-balanced.domains" "$source_dir/cn-lean.domains")
  [ "$missing" -eq 0 ] || fail "cn lean is not a subset of balanced"
  missing=$(awk 'NR == FNR { parent[$1] = 1; next } !/^[[:space:]]*(#|$)/ && !($1 in parent) { count++ } END { print count + 0 }' \
    "$source_dir/cn-strict.domains" "$source_dir/cn-balanced.domains")
  [ "$missing" -eq 0 ] || fail "cn balanced is not a subset of strict"
  missing=$(awk 'NR == FNR { parent[$1] = 1; next } !/^[[:space:]]*(#|$)/ && !($1 in parent) { count++ } END { print count + 0 }' \
    "$source_dir/global-balanced.domains" "$source_dir/global-lean.domains")
  [ "$missing" -eq 0 ] || fail "global lean is not a subset of balanced"
  missing=$(awk 'NR == FNR { parent[$1] = 1; next } !/^[[:space:]]*(#|$)/ && !($1 in parent) { count++ } END { print count + 0 }' \
    "$source_dir/global-strict.domains" "$source_dir/global-balanced.domains")
  [ "$missing" -eq 0 ] || fail "global balanced is not a subset of strict"
  overlap=$(awk 'NR == FNR { cn[$1] = 1; next } !/^[[:space:]]*(#|$)/ && $1 in cn { count++ } END { print count + 0 }' \
    "$source_dir/cn-strict.domains" "$source_dir/global-strict.domains")
  [ "$overlap" -eq 0 ] || fail "domestic and global rules overlap"
  for profile in cn-lean cn-balanced cn-strict global-lean global-balanced global-strict; do
    overlap=$(awk 'NR == FNR { reward[$1] = 1; next } !/^[[:space:]]*(#|$)/ && $1 in reward { count++ } END { print count + 0 }' \
      "$source_dir/reward-ads.domains" "$source_dir/$profile.domains")
    [ "$overlap" -eq 0 ] || fail "reward rules overlap $profile"
  done

  rules_root=$DATA_DIR/rules
  pending=$rules_root/.pending.$$
  old=$rules_root/.old.$$
  mkdir -p "$pending" || fail "cannot create rule staging area"
  for name in $RULE_FILES; do
    cp -f "$source_dir/$name" "$pending/$name" || fail "cannot stage $name"
  done
  chmod 0600 "$pending"/* 2>/dev/null
  old_version=$(cat "$RULE_VERSION_STATE" 2>/dev/null)
  case "$old_version" in ''|*[!0-9]*) old_version=0 ;; esac
  rm -rf "$old"
  [ ! -d "$rules_root/current" ] || mv "$rules_root/current" "$old" ||
    fail "cannot preserve current rules"
  if ! mv "$pending" "$rules_root/current"; then
    [ ! -d "$old" ] || mv "$old" "$rules_root/current"
    fail "cannot activate rules"
  fi
  echo "$version" > "$RULE_VERSION_STATE"
  if build_output=$(ADSHIELD_LOCK_HELD=1 "$MODDIR/bin/rulectl" __build 2>&1); then
    rm -rf "$rules_root/previous"
    [ ! -d "$old" ] || mv "$old" "$rules_root/previous"
  else
    rm -rf "$rules_root/current"
    [ ! -d "$old" ] || mv "$old" "$rules_root/current"
    echo "$old_version" > "$RULE_VERSION_STATE"
    restore_output=$(ADSHIELD_LOCK_HELD=1 "$MODDIR/bin/rulectl" __build 2>&1) ||
      fail "new rules failed and previous rules could not be restored: $restore_output"
    rm -rf "$source_dir"
    fail "new rules failed; previous rules were restored: $build_output"
  fi
  rm -rf "$source_dir"
  log_event "rules-installed version=$version"
  status_json
}

rollback_rules() {
  rules_root=$DATA_DIR/rules
  [ -d "$rules_root/previous" ] || fail "no previous rule version is available"
  rollback=$rules_root/.rollback-current.$$
  old_version=$(cat "$RULE_VERSION_STATE" 2>/dev/null)
  case "$old_version" in ''|*[!0-9]*) old_version=0 ;; esac
  rm -rf "$rollback"
  [ ! -d "$rules_root/current" ] || mv "$rules_root/current" "$rollback" ||
    fail "cannot preserve current rules"
  if ! mv "$rules_root/previous" "$rules_root/current"; then
    [ ! -d "$rollback" ] || mv "$rollback" "$rules_root/current"
    fail "cannot restore previous rules"
  fi
  version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$rules_root/current/manifest.json" | head -n 1)
  case "$version" in ''|*[!0-9]*) version=0 ;; esac
  echo "$version" > "$RULE_VERSION_STATE"
  if build_output=$(ADSHIELD_LOCK_HELD=1 "$MODDIR/bin/rulectl" __build 2>&1); then
    [ ! -d "$rollback" ] || mv "$rollback" "$rules_root/previous"
  else
    rm -rf "$rules_root/current"
    [ ! -d "$rollback" ] || mv "$rollback" "$rules_root/current"
    echo "$old_version" > "$RULE_VERSION_STATE"
    restore_output=$(ADSHIELD_LOCK_HELD=1 "$MODDIR/bin/rulectl" __build 2>&1) ||
      fail "rollback failed and current rules could not be restored: $restore_output"
    fail "rollback failed; current rules were restored: $build_output"
  fi
  log_event "rules-rollback version=$version"
  status_json
}

same_file() {
  [ -f "$ACTIVE_HOSTS" ] && [ -f "$HOSTS_TARGET" ] || return 1
  if [ "$TEST_MODE" = "1" ]; then
    cmp -s "$ACTIVE_HOSTS" "$HOSTS_TARGET"
    return
  fi
  source_stat=$(stat -c '%d:%i' "$ACTIVE_HOSTS" 2>/dev/null)
  target_stat=$(stat -c '%d:%i' "$HOSTS_TARGET" 2>/dev/null)
  [ -n "$source_stat" ] && [ "$source_stat" = "$target_stat" ]
}

ensure_mounted() {
  same_file && return 0
  if [ "$TEST_MODE" = "1" ]; then
    cp -f "$ACTIVE_HOSTS" "$HOSTS_TARGET" || fail "cannot publish test hosts file"
    return
  fi
  mount --bind "$ACTIVE_HOSTS" "$HOSTS_TARGET" >/dev/null 2>&1 || \
    mount -o bind "$ACTIVE_HOSTS" "$HOSTS_TARGET" >/dev/null 2>&1 || \
    fail "cannot bind active hosts file"
}

publish_active() {
  new_file=$1
  if [ -f "$ACTIVE_HOSTS" ]; then
    cp -f "$new_file" "$ACTIVE_HOSTS" || fail "cannot update active hosts"
    rm -f "$new_file"
  else
    mv -f "$new_file" "$ACTIVE_HOSTS" || fail "cannot create active hosts"
  fi
  chown 0:0 "$ACTIVE_HOSTS" 2>/dev/null
  chmod 0644 "$ACTIVE_HOSTS" 2>/dev/null
  chcon u:object_r:system_file:s0 "$ACTIVE_HOSTS" 2>/dev/null
  ensure_mounted
}

build_active() {
  ensure_state
  cn_profile=$(cat "$CN_PROFILE_STATE" 2>/dev/null)
  global_profile=$(cat "$GLOBAL_PROFILE_STATE" 2>/dev/null)
  cn_file=
  if [ "$cn_profile" != "off" ]; then
    cn_file=$(profile_path cn "$cn_profile") || fail "invalid domestic profile state"
    [ -f "$cn_file" ] || fail "domestic profile rules are missing: $cn_profile"
  fi
  global_file=
  if [ "$global_profile" != "off" ]; then
    global_file=$(profile_path global "$global_profile") || fail "global profile is not installed: $global_profile"
    [ -f "$global_file" ] || fail "global profile rules are missing: $global_profile"
  fi

  tmp_dir=$STATE_DIR/.build.$$
  mkdir -p "$tmp_dir" || fail "cannot create temporary directory"
  skip_file=$tmp_dir/skip
  reward_file=$tmp_dir/reward
  enabled_reward_file=$tmp_dir/enabled-reward
  base_file=$tmp_dir/base
  pack_file=$tmp_dir/packs
  block_file=$tmp_dir/block
  filtered_file=$tmp_dir/filtered
  output_file=$tmp_dir/active.hosts

  cat "$USER_DIR/allow.txt" "$USER_DIR/disabled.txt" 2>/dev/null | \
    sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' | awk '!seen[$0]++' > "$skip_file"
  write_reward_union "$reward_file"
  write_enabled_reward_union "$enabled_reward_file"
  {
    [ -z "$cn_file" ] || cat "$cn_file"
    [ -z "$global_file" ] || cat "$global_file"
  } | sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' | awk '!seen[$0]++' > "$tmp_dir/profiles"
  awk 'NR == FNR { reward[$1] = 1; next } !/^[[:space:]]*(#|$)/ && !($1 in reward) { print $1 }' \
    "$reward_file" "$tmp_dir/profiles" > "$base_file"
  : > "$pack_file"
  now=$(date +%s)
  reward_until=$(cat "$REWARD_UNTIL_STATE" 2>/dev/null)
  case "$reward_until" in ''|*[!0-9]*) reward_until=0 ;; esac
  if [ "$reward_until" -le "$now" ]; then
    cp -f "$enabled_reward_file" "$pack_file"
  fi
  cat "$base_file" "$pack_file" "$USER_DIR/block.txt" 2>/dev/null | \
    sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' | awk '!seen[$0]++' > "$block_file"
  awk 'FILENAME == ARGV[1] { skip[$1] = 1; next } !($1 in skip) { print $1 }' \
    "$skip_file" "$block_file" > "$filtered_file"

  if [ "$(cat "$PROTECTION_STATE" 2>/dev/null)" = "0" ]; then
    : > "$filtered_file"
  fi

  compiled=$(count_domains "$base_file")
  running=$(count_domains "$filtered_file")
  reward_block=$(count_domains "$enabled_reward_file")
  version=$(cat "$RULE_VERSION_STATE" 2>/dev/null)
  {
    echo "# WeiG ZeroAd active hosts. Managed by rulectl."
    echo "# cn_profile=$cn_profile"
    echo "# global_profile=$global_profile"
    echo "# rule_version=$version"
    echo "# rule_count=$running"
    echo "127.0.0.1 localhost"
    echo "::1 localhost ip6-localhost ip6-loopback"
    awk '{ print "0.0.0.0 " $1 }' "$filtered_file"
  } > "$output_file" || fail "cannot build active hosts"

  publish_active "$output_file"
  stats_tmp=$ACTIVE_STATS.$$
  {
    echo "compiled=$compiled"
    echo "running=$running"
    echo "reward_block=$reward_block"
  } > "$stats_tmp" && mv -f "$stats_tmp" "$ACTIVE_STATS"
  chmod 0600 "$ACTIVE_STATS" 2>/dev/null
  rm -rf "$tmp_dir"
  log_event "applied cn=$cn_profile global=$global_profile running=$running"
}

list_add() {
  list=$1
  domain=$2
  tmp=$list.$$
  { cat "$list" 2>/dev/null; echo "$domain"; } | \
    sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' | awk '!seen[$0]++' > "$tmp" || fail "cannot update rule list"
  mv -f "$tmp" "$list" || fail "cannot save rule list"
  chmod 0600 "$list" 2>/dev/null
}

list_remove() {
  list=$1
  domain=$2
  tmp=$list.$$
  awk -v domain="$domain" '$0 != domain { print }' "$list" 2>/dev/null > "$tmp"
  mv -f "$tmp" "$list" || fail "cannot save rule list"
  chmod 0600 "$list" 2>/dev/null
}

domain_argument() {
  [ -n "$1" ] || fail "domain is required"
  domain=$(normalize_domain "$1")
  valid_domain "$domain" || fail "invalid exact domain: $1"
  printf '%s\n' "$domain"
}

set_profile() {
  region=$1
  new_profile=$2
  case "$region" in
    cn)
      if [ "$new_profile" = "off" ]; then
        current=$(cat "$CN_PROFILE_STATE" 2>/dev/null)
        case "$current" in lean|balanced|strict) echo "$current" > "$CN_LAST_PROFILE_STATE" ;; esac
        echo off > "$CN_PROFILE_STATE"
      else
        [ "$new_profile" != "on" ] || new_profile=$(cat "$CN_LAST_PROFILE_STATE" 2>/dev/null)
        case "$new_profile" in lean|balanced|strict) ;;
          *) new_profile=lean ;; esac
        profile_path cn "$new_profile" >/dev/null || fail "unknown domestic profile: $new_profile"
        echo "$new_profile" > "$CN_PROFILE_STATE"
        echo "$new_profile" > "$CN_LAST_PROFILE_STATE"
      fi
      ;;
    global)
      if [ "$new_profile" = "off" ]; then
        echo off > "$GLOBAL_PROFILE_STATE"
      else
        profile_path global "$new_profile" >/dev/null || fail "global profile is not installed: $new_profile"
        echo "$new_profile" > "$GLOBAL_PROFILE_STATE"
      fi
      ;;
    *) fail "unknown profile region: $region" ;;
  esac
  build_active
}

set_pack() {
  action=$1
  pack_id=$2
  source=$(pack_path "$pack_id") || fail "unknown rule pack: $pack_id"
  [ -f "$source" ] || fail "rule pack is not installed: $pack_id"
  if [ "$action" = "enable" ]; then
    list_add "$ENABLED_PACKS_STATE" "$pack_id"
  else
    list_remove "$ENABLED_PACKS_STATE" "$pack_id"
  fi
  build_active
}

start_reward_timer() {
  minutes=$1
  case "$minutes" in
    ''|*[!0-9]*) fail "reward duration must be an integer" ;;
  esac
  [ "$minutes" -ge 1 ] && [ "$minutes" -le 1440 ] || fail "reward duration must be 1-1440 minutes"
  ensure_state
  [ "$(count_domains "$ENABLED_PACKS_STATE")" -gt 0 ] || fail "enable a reward-ad pack first"
  expires=$(( $(date +%s) + minutes * 60 ))
  echo "$expires" > "$REWARD_UNTIL_STATE"
  build_active
  log_event "reward-allow minutes=$minutes"
  if [ "$TEST_MODE" != "1" ]; then
    (
      sleep $(( minutes * 60 ))
      "$MODDIR/bin/rulectl" reward-expire "$expires" >/dev/null 2>&1
    ) &
  fi
  echo "reward ads allowed until $expires"
}

expire_reward() {
  expected=$1
  ensure_state
  actual=$(cat "$REWARD_UNTIL_STATE" 2>/dev/null)
  case "$actual" in ''|*[!0-9]*) actual=0 ;; esac
  [ "$expected" = "$actual" ] || return 0
  [ "$actual" -gt 0 ] || return 0
  echo 0 > "$REWARD_UNTIL_STATE"
  build_active
  log_event "reward-blocking-restored"
}

resume_reward_timer() {
  expires=$(cat "$REWARD_UNTIL_STATE" 2>/dev/null)
  case "$expires" in ''|*[!0-9]*) expires=0 ;; esac
  now=$(date +%s)
  if [ "$expires" -le "$now" ]; then
    expire_reward "$expires"
  else
    remaining=$(( expires - now ))
    (
      sleep "$remaining"
      "$MODDIR/bin/rulectl" reward-expire "$expires" >/dev/null 2>&1
    ) &
  fi
}

status_json() {
  ensure_state
  cn_profile=$(cat "$CN_PROFILE_STATE" 2>/dev/null)
  global_profile=$(cat "$GLOBAL_PROFILE_STATE" 2>/dev/null)
  cn_file=
  [ "$cn_profile" = "off" ] || cn_file=$(profile_path cn "$cn_profile" 2>/dev/null)
  global_file=
  [ "$global_profile" = "off" ] || global_file=$(profile_path global "$global_profile" 2>/dev/null)
  compiled=$(sed -n 's/^compiled=//p' "$ACTIVE_STATS" 2>/dev/null | head -n 1)
  running=$(sed -n 's/^running=//p' "$ACTIVE_STATS" 2>/dev/null | head -n 1)
  reward_block=$(sed -n 's/^reward_block=//p' "$ACTIVE_STATS" 2>/dev/null | head -n 1)
  case "$compiled" in ''|*[!0-9]*)
    reward_all_tmp=$STATE_DIR/.reward-all.$$
    profile_all_tmp=$STATE_DIR/.profiles-all.$$
    write_reward_union "$reward_all_tmp"
    {
      [ -z "$cn_file" ] || cat "$cn_file" 2>/dev/null
      [ -z "$global_file" ] || cat "$global_file" 2>/dev/null
    } | sed '/^[[:space:]]*#/d;/^[[:space:]]*$/d' | awk '!seen[$0]++' > "$profile_all_tmp"
    compiled=$(awk 'NR == FNR { reward[$1] = 1; next } !/^[[:space:]]*(#|$)/ && !($1 in reward) { count++ } END { print count + 0 }' \
      "$reward_all_tmp" "$profile_all_tmp")
    rm -f "$reward_all_tmp" "$profile_all_tmp"
    ;;
  esac
  case "$running" in ''|*[!0-9]*) running=$(count_running) ;; esac
  disabled=$(count_domains "$USER_DIR/disabled.txt")
  user_block=$(count_domains "$USER_DIR/block.txt")
  user_allow=$(count_domains "$USER_DIR/allow.txt")
  version=$(cat "$RULE_VERSION_STATE" 2>/dev/null)
  reward_until=$(cat "$REWARD_UNTIL_STATE" 2>/dev/null)
  case "$reward_until" in ''|*[!0-9]*) reward_until=0 ;; esac
  now=$(date +%s)
  [ "$reward_until" -gt "$now" ] && reward_active=true || reward_active=false
  enabled_packs=
  while IFS= read -r pack_id; do
    [ -n "$pack_id" ] || continue
    source=$(pack_path "$pack_id") || continue
    [ -z "$enabled_packs" ] && enabled_packs=$pack_id || enabled_packs=$enabled_packs,$pack_id
  done < "$ENABLED_PACKS_STATE"
  case "$reward_block" in ''|*[!0-9]*)
    pack_tmp=$STATE_DIR/.packs.$$
    write_enabled_reward_union "$pack_tmp"
    reward_block=$(count_domains "$pack_tmp")
    rm -f "$pack_tmp"
    ;;
  esac
  [ "$(cat "$PROTECTION_STATE" 2>/dev/null)" = "1" ] && protection=true || protection=false
  if [ -d /data/adb/modules_update/weig_rootad ] || [ -f /data/adb/modules/weig_rootad/update ]; then
    pending_reboot=true
  else
    pending_reboot=false
  fi
  same_file && healthy=true || healthy=false
  [ -f "$DATA_DIR/rules/current/manifest.json" ] && rules_downloaded=true || rules_downloaded=false
  root_impl=unknown
  command -v magisk >/dev/null 2>&1 && root_impl=magisk
  command -v ksud >/dev/null 2>&1 && root_impl=kernelsu
  command -v apd >/dev/null 2>&1 && root_impl=apatch
  core_version=$(sed -n 's/^version=//p' "$MODDIR/module.prop" 2>/dev/null | head -n 1 | tr -cd 'A-Za-z0-9._+-')
  core_version_code=$(sed -n 's/^versionCode=//p' "$MODDIR/module.prop" 2>/dev/null | head -n 1)
  case "$core_version_code" in ''|*[!0-9]*) core_version_code=0 ;; esac
  printf '{"schema":3,"pending_reboot":%s,"protection_enabled":%s,"healthy":%s,"root_impl":"%s","core_version":"%s","core_version_code":%s,"cn_profile":"%s","global_profile":"%s","rule_version":%s,"rules_downloaded":%s,"compiled_rules":%s,"running_rules":%s,"disabled_rules":%s,"user_block_rules":%s,"user_allow_rules":%s,"reward_block_rules":%s,"reward_temporarily_allowed":%s,"reward_expires_at":%s,"enabled_packs":"%s"}\n' \
    "$pending_reboot" "$protection" "$healthy" "$root_impl" "$core_version" "$core_version_code" "$cn_profile" "$global_profile" "$version" "$rules_downloaded" "$compiled" "$running" "$disabled" "$user_block" "$user_allow" "$reward_block" "$reward_active" "$reward_until" "$enabled_packs"
}

command=${1:-status}
ensure_state
acquire_lock

case "$command" in
  status)
    status_json
    ;;
  boot)
    build_active
    resume_reward_timer
    ;;
  rebuild)
    build_active
    status_json
    ;;
  __build)
    [ "${ADSHIELD_LOCK_HELD:-0}" = "1" ] || fail "internal command"
    build_active
    ;;
  cn-profile)
    [ -n "${2:-}" ] || fail "domestic profile name is required"
    set_profile cn "$2"
    status_json
    ;;
  global-profile)
    [ -n "${2:-}" ] || fail "global profile name is required"
    set_profile global "$2"
    status_json
    ;;
  profile)
    # Backward-compatible command for older manager versions.
    [ -n "${2:-}" ] || fail "profile name is required"
    case "$2" in strict|balanced) set_profile cn "$2" ;; *) fail "unknown legacy profile: $2" ;; esac
    status_json
    ;;
  reward)
    start_reward_timer "${2:-10}"
    status_json
    ;;
  reward-expire)
    expire_reward "${2:-0}"
    ;;
  reward-stop)
    expire_reward "$(cat "$REWARD_UNTIL_STATE" 2>/dev/null)"
    status_json
    ;;
  pack-enable)
    [ -n "${2:-}" ] || fail "pack id is required"
    set_pack enable "$2"
    status_json
    ;;
  pack-disable)
    [ -n "${2:-}" ] || fail "pack id is required"
    set_pack disable "$2"
    status_json
    ;;
  protection-on)
    echo 1 > "$PROTECTION_STATE"
    date +%s > "$PROTECTION_STARTED_STATE"
    build_active
    log_event "protection-enabled"
    status_json
    ;;
  protection-off)
    echo 0 > "$PROTECTION_STATE"
    echo 0 > "$PROTECTION_STARTED_STATE"
    build_active
    log_event "protection-disabled"
    status_json
    ;;
  domain-disable)
    domain=$(domain_argument "${2:-}")
    list_add "$USER_DIR/disabled.txt" "$domain"
    build_active
    status_json
    ;;
  domain-enable)
    domain=$(domain_argument "${2:-}")
    list_remove "$USER_DIR/disabled.txt" "$domain"
    build_active
    status_json
    ;;
  allow-add)
    domain=$(domain_argument "${2:-}")
    list_remove "$USER_DIR/block.txt" "$domain"
    list_add "$USER_DIR/allow.txt" "$domain"
    build_active
    status_json
    ;;
  allow-remove)
    domain=$(domain_argument "${2:-}")
    list_remove "$USER_DIR/allow.txt" "$domain"
    build_active
    status_json
    ;;
  block-add)
    domain=$(domain_argument "${2:-}")
    list_remove "$USER_DIR/allow.txt" "$domain"
    list_add "$USER_DIR/block.txt" "$domain"
    build_active
    status_json
    ;;
  block-remove)
    domain=$(domain_argument "${2:-}")
    list_remove "$USER_DIR/block.txt" "$domain"
    build_active
    status_json
    ;;
  rules-install-dir)
    [ -n "${2:-}" ] || fail "staging directory is required"
    install_rule_directory "$2"
    ;;
  rules-rollback)
    rollback_rules
    ;;
  list-disabled)
    cat "$USER_DIR/disabled.txt"
    ;;
  list-allow)
    cat "$USER_DIR/allow.txt"
    ;;
  list-block)
    cat "$USER_DIR/block.txt"
    ;;
  events)
    print_events
    ;;
  cleanup-mount)
    if [ "$TEST_MODE" = "1" ]; then
      rm -f "$HOSTS_TARGET"
    elif same_file; then
      umount "$HOSTS_TARGET" >/dev/null 2>&1 || fail "cannot unmount active hosts"
    fi
    ;;
  *)
    fail "unknown command: $command"
    ;;
esac
